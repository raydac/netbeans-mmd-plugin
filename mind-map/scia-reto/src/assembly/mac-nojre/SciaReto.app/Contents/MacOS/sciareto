#!/bin/sh
BASEDIR=$(cd "$(dirname "$0")" && pwd)

if [ -z "$JAVA_HOME" ] || [ ! -x "$JAVA_HOME/bin/java" ]; then
  JAVA_HOME="/Library/Internet Plug-Ins/JavaAppletPlugin.plugin/Contents/Home"
fi

if [ -x "$JAVA_HOME/bin/java" ]; then
  JAVA_RUN="$JAVA_HOME/bin/java"
elif command -v java >/dev/null 2>&1; then
  JAVA_RUN=java
else
  echo "can't find any installed java" >&2
  exit 1
fi

JAR=
for candidate in "$BASEDIR"/scia-reto-*.jar; do
  if [ -f "$candidate" ]; then
    JAR=$candidate
    break
  fi
done

if [ -z "$JAR" ]; then
  echo "SciaReto jar not found under $BASEDIR" >&2
  exit 1
fi

exec "$JAVA_RUN" -Xmx2G --add-opens=java.desktop/com.apple.eawt=ALL-UNNAMED -Djava.util.logging.config.file="$BASEDIR/logger.properties" -jar "$JAR" "$@"
